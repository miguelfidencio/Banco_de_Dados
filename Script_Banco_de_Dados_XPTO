CREATE DATABASE XPTO;
USE XPTO;

CREATE TABLE CARGO
(
    COD_CARGO INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(50) NOT NULL,
    SALARIO DECIMAL(10,2) NOT NULL
);

CREATE TABLE SETOR
(
    COD_SETOR INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(50) NOT NULL,
    RAMAL INT NOT NULL
);

CREATE TABLE FUNCIONARIO
(
    COD_FUNC INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    NOME VARCHAR(50) NOT NULL,
    ADMISSAO DATETIME NOT NULL,
    COD_CARGO INT NOT NULL,
    COD_SETOR INT NOT NULL,
    CONSTRAINT FK_CARGO FOREIGN KEY (COD_CARGO)
        REFERENCES CARGO(COD_CARGO),
    CONSTRAINT FK_SETOR FOREIGN KEY (COD_SETOR)
        REFERENCES SETOR(COD_SETOR)
);
