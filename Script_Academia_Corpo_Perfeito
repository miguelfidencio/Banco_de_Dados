CREATE DATABASE ACADEMIA;
USE ACADEMIA;

CREATE TABLE ALUNOS
(
    COD_ALU INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    NOME VARCHAR(100) NOT NULL,
    TELEFONE VARCHAR(20),
    EMAIL VARCHAR(100),
    SEXO CHAR(1),
    RUA VARCHAR(100),
    NUMERO VARCHAR(10),
    COMPLEMENTO VARCHAR(50),
    BAIRRO VARCHAR(50),
    CIDADE VARCHAR(50),
    ESTADO CHAR(2),
    CEP VARCHAR(10)
);

CREATE TABLE PROFESSORES
(
    CREF INT PRIMARY KEY NOT NULL,
    NOME VARCHAR(100) NOT NULL,
    TELEFONE VARCHAR(20),
    ENDERECO VARCHAR(200)
);

CREATE TABLE ESPECIALIDADES
(
    COD_ESP INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL
);

CREATE TABLE AULAS
(
    COD_AULA INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL,
    CREF INT NOT NULL,
    CONSTRAINT FK_AULA_PROFESSOR FOREIGN KEY (CREF)
        REFERENCES PROFESSORES(CREF)
);

CREATE TABLE FREQUENTA
(
    COD_ALU INT NOT NULL,
    COD_AULA INT NOT NULL,
    PRIMARY KEY (COD_ALU, COD_AULA),
    CONSTRAINT FK_FREQ_ALUNO FOREIGN KEY (COD_ALU)
        REFERENCES ALUNOS(COD_ALU),
    CONSTRAINT FK_FREQ_AULA FOREIGN KEY (COD_AULA)
        REFERENCES AULAS(COD_AULA)
);

CREATE TABLE POSSUI
(
    CREF INT NOT NULL,
    COD_ESP INT NOT NULL,
    PRIMARY KEY (CREF, COD_ESP),
    CONSTRAINT FK_POSSUI_PROF FOREIGN KEY (CREF)
        REFERENCES PROFESSORES(CREF),
    CONSTRAINT FK_POSSUI_ESP FOREIGN KEY (COD_ESP)
        REFERENCES ESPECIALIDADES(COD_ESP)
);
