CREATE DATABASE PEDIDO_VENDA;
USE PEDIDO_VENDA;

CREATE TABLE FILIAIS
(
    COD_FILIAL INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    RAZAO_SOCIAL VARCHAR(100) NOT NULL,
    RUA VARCHAR(100),
    NUMERO VARCHAR(10),
    COMPLEMENTO VARCHAR(50),
    BAIRRO VARCHAR(50),
    CIDADE VARCHAR(50),
    ESTADO CHAR(2),
    CEP VARCHAR(10),
    SITE VARCHAR(150),
    EMAIL VARCHAR(100)
);

CREATE TABLE CLIENTES
(
    COD_CLI INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    NOME VARCHAR(100) NOT NULL,
    RUA VARCHAR(100),
    NUMERO VARCHAR(10),
    COMPLEMENTO VARCHAR(50),
    BAIRRO VARCHAR(50),
    CIDADE VARCHAR(50),
    ESTADO CHAR(2),
    CEP VARCHAR(10)
);

CREATE TABLE VENDEDORES
(
    COD_VEN INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    NOME VARCHAR(100) NOT NULL
);

CREATE TABLE CONDICAO_PAGAMENTO
(
    COD_COND INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL
);

CREATE TABLE PRODUTOS
(
    COD_PROD INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL,
    TIPO_UNI VARCHAR(20),
    PRE_UNI_VEND DECIMAL(10,2) NOT NULL
);

CREATE TABLE VENDAS
(
    COD_FIL INT NOT NULL,
    NUM_PED INT NOT NULL,
    COD_CLI INT NOT NULL,
    COD_VEN INT NOT NULL,
    COD_COND INT NOT NULL,
    DATA_EMISSAO DATETIME NOT NULL,
    PRAZO VARCHAR(50),
    OBSERVACOES VARCHAR(255),
    FRETE DECIMAL(10,2),
    AVISOS_CLI VARCHAR(255),
    PRIMARY KEY (COD_FIL, NUM_PED),
    CONSTRAINT FK_VENDA_FILIAL FOREIGN KEY (COD_FIL)
        REFERENCES FILIAIS(COD_FILIAL),
    CONSTRAINT FK_VENDA_CLIENTE FOREIGN KEY (COD_CLI)
        REFERENCES CLIENTES(COD_CLI),
    CONSTRAINT FK_VENDA_VENDEDOR FOREIGN KEY (COD_VEN)
        REFERENCES VENDEDORES(COD_VEN),
    CONSTRAINT FK_VENDA_COND FOREIGN KEY (COD_COND)
        REFERENCES CONDICAO_PAGAMENTO(COD_COND)
);

CREATE TABLE ITEM
(
    COD_FIL INT NOT NULL,
    NUM_PED INT NOT NULL,
    COD_PRO INT NOT NULL,
    QTDE INT NOT NULL,
    DESCONTO DECIMAL(10,2),
    PRIMARY KEY (COD_FIL, NUM_PED, COD_PRO),
    CONSTRAINT FK_ITEM_VENDA FOREIGN KEY (COD_FIL, NUM_PED)
        REFERENCES VENDAS(COD_FIL, NUM_PED),
    CONSTRAINT FK_ITEM_PRODUTO FOREIGN KEY (COD_PRO)
        REFERENCES PRODUTOS(COD_PROD)
);
