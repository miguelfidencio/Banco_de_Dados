-- BANCO DE DADOS - NOTA FISCAL ELETRÔNICA (NFE)

CREATE DATABASE NFE;

USE NFE;

-- CRIAR A TABELA FILIAIS

CREATE TABLE FILIAIS
(
    ID_FILIAL INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    RAZAO_SOCIAL VARCHAR(100) NOT NULL,
    LOGRADOURO VARCHAR(100),
    NUMERO VARCHAR(10),
    COMPLEMENTO VARCHAR(50),
    BAIRRO VARCHAR(50),
    CIDADE VARCHAR(50),
    UF CHAR(2),
    CEP VARCHAR(10),
    FONE VARCHAR(20),
    SITE VARCHAR(100),
    EMAIL VARCHAR(100),
    CNPJ VARCHAR(18) NOT NULL,
    INSC_ESTAD VARCHAR(20),
    POR_MED_IMP DECIMAL(5,2)
);

-- CRIAR A TABELA CLIENTES

CREATE TABLE CLIENTES
(
    ID_CLIENTE INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    NOME VARCHAR(100) NOT NULL,
    LOGRADOURO VARCHAR(100),
    NUMERO VARCHAR(10),
    COMPLEMENTO VARCHAR(50),
    BAIRRO VARCHAR(50),
    CIDADE VARCHAR(50),
    UF CHAR(2),
    CEP VARCHAR(10),
    FONE VARCHAR(20),
    EMAIL VARCHAR(100),
    CPF VARCHAR(14),
    RG VARCHAR(20),
    CNPJ VARCHAR(18),
    INSC_ESTAD VARCHAR(20)
);

-- CRIAR A TABELA NATUREZAS

CREATE TABLE NATUREZAS
(
    ID_NAT INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL,
    CFOP VARCHAR(10),
    BASE_ICMS DECIMAL(15,2),
    POR_ICMS DECIMAL(5,2),
    BASE_IPI DECIMAL(15,2),
    POR_IPI DECIMAL(5,2)
);

-- CRIAR A TABELA TRANSPORTADORAS

CREATE TABLE TRANSPORTADORAS
(
    ID_TRANS INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    RAZAO_SOCIAL VARCHAR(100) NOT NULL,
    LOGRADOURO VARCHAR(100),
    NUMERO VARCHAR(10),
    COMPLEMENTO VARCHAR(50),
    BAIRRO VARCHAR(50),
    CIDADE VARCHAR(50),
    UF CHAR(2),
    CEP VARCHAR(10),
    CNPJ VARCHAR(18),
    INSC_ESTAD VARCHAR(20),
    PLACA VARCHAR(10),
    COD_ANTT VARCHAR(20)
);

-- CRIAR A TABELA PRODUTOS

CREATE TABLE PRODUTOS
(
    COD_PROD INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL,
    DESCRICAO_COMPL VARCHAR(255),
    NCM VARCHAR(20),
    CST VARCHAR(10),
    TIPO_UNID VARCHAR(10),
    VALOR_UNIT DECIMAL(15,2),
    EMITE VARCHAR(20)
);

-- CRIAR A TABELA NOTAS_FISCAIS

CREATE TABLE NOTAS_FISCAIS
(
    ID_FILIAL INT NOT NULL,
    NUM_NFE INT NOT NULL,
    SERIE INT,
    TIPO_E_S CHAR(1),
    CHAVE VARCHAR(44),
    PROTOCOLO VARCHAR(50),
    DATAHORA_PROT DATETIME,
    DATAHORA_EMISSAO DATETIME,
    DATAHORA_SAIDA DATETIME,
    FRETE_POR_CONTA CHAR(1),
    QTDE DECIMAL(15,3),
    ESPECIE VARCHAR(30),
    MARCA VARCHAR(50),
    NUMERACAO VARCHAR(30),
    PESO_BRUTO DECIMAL(15,3),
    PESO_LIQUIDO DECIMAL(15,3),
    INF_COMPLEM VARCHAR(500),
    ID_CLIENTE INT NOT NULL,
    ID_TRANS INT,
    ID_NAT INT NOT NULL,

    PRIMARY KEY (ID_FILIAL, NUM_NFE),

    CONSTRAINT FK_NFE_FILIAL
        FOREIGN KEY NOTAS_FISCAIS(ID_FILIAL)
        REFERENCES FILIAIS(ID_FILIAL),

    CONSTRAINT FK_NFE_CLIENTE
        FOREIGN KEY NOTAS_FISCAIS(ID_CLIENTE)
        REFERENCES CLIENTES(ID_CLIENTE),

    CONSTRAINT FK_NFE_TRANSPORTADORA
        FOREIGN KEY NOTAS_FISCAIS(ID_TRANS)
        REFERENCES TRANSPORTADORAS(ID_TRANS),

    CONSTRAINT FK_NFE_NATUREZA
        FOREIGN KEY NOTAS_FISCAIS(ID_NAT)
        REFERENCES NATUREZAS(ID_NAT)
);

-- CRIAR A TABELA ITENS_NFE

CREATE TABLE ITENS_NFE
(
    ID_FILIAL INT NOT NULL,
    NUM_NFE INT NOT NULL,
    ITEM INT NOT NULL,
    COD_PROD INT NOT NULL,
    QTDE DECIMAL(15,3) NOT NULL,
    DESCONTO DECIMAL(15,2),

    PRIMARY KEY (ID_FILIAL, NUM_NFE, ITEM),

    CONSTRAINT FK_ITEM_NFE
        FOREIGN KEY ITENS_NFE(ID_FILIAL, NUM_NFE)
        REFERENCES NOTAS_FISCAIS(ID_FILIAL, NUM_NFE),

    CONSTRAINT FK_ITEM_PRODUTO
        FOREIGN KEY ITENS_NFE(COD_PROD)
        REFERENCES PRODUTOS(COD_PROD)
);

