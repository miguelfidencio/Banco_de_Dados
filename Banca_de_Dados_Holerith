-- BANCO DE DADOS HOLERITH

CREATE DATABASE IF NOT EXISTS HOLERITH;
USE HOLERITH;
 
-- TABELA PAI: FILIAIS
CREATE TABLE FILIAIS
(
    COD_FIL INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    RAZAO VARCHAR(100) NOT NULL,
    LOGRADOURO VARCHAR(100),
    NUMERO VARCHAR(10),
    COMPLEMENTO VARCHAR(50),
    BAIRRO VARCHAR(50),
    CIDADE VARCHAR(50),
    ESTADO CHAR(2),
    CEP VARCHAR(10),
    CNPJ VARCHAR(18),
    SALARIO_BASE DECIMAL(10,2)
);
 
--  TABELA PAI: CARGOS
CREATE TABLE CARGOS
(
    COD_CARGO INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL
);
 
--  TABELA PAI: DEPARTAMENTO
CREATE TABLE DEPARTAMENTO
(
    COD_DEP INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL
);
 
--  TABELA PAI: PROV_DESC
CREATE TABLE PROV_DESC
(
    COD_PROV INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    DESCRICAO VARCHAR(100) NOT NULL,
    TIPO VARCHAR(20),
    INSS DECIMAL(5,2),
    FGTS DECIMAL(5,2),
    IRRF DECIMAL(5,2)
);
 
--  TABELA FILHA: CLIENTES
CREATE TABLE CLIENTES
(
    COD_CLI INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    RAZAO VARCHAR(100) NOT NULL,
    LOGRADOURO VARCHAR(100),
    NUMERO VARCHAR(10),
    COMPLEMENTO VARCHAR(50),
    BAIRRO VARCHAR(50),
    CIDADE VARCHAR(50),
    ESTADO CHAR(2),
    CEP VARCHAR(10),
    CNPJ VARCHAR(18),
    COD_FIL INT NOT NULL,
    CONSTRAINT FK_FILIAL_CLIENTE
        FOREIGN KEY CLIENTES(COD_FIL)
        REFERENCES FILIAIS(COD_FIL)
);
 
--  TABELA FILHA: FUNCIONARIOS
CREATE TABLE FUNCIONARIOS
(
    COD_FIL INT NOT NULL,
    COD_FUN INT PRIMARY KEY NOT NULL AUTO_INCREMENT,
    NOME VARCHAR(50) NOT NULL,
    ADMISSAO DATETIME NOT NULL,
    SALARIO DECIMAL(10,2) NOT NULL,
    COD_DEP INT NOT NULL,
    COD_CARGO INT NOT NULL,
    CONSTRAINT FK_FILIAL_FUNC
        FOREIGN KEY FUNCIONARIOS(COD_FIL)
        REFERENCES FILIAIS(COD_FIL),
    CONSTRAINT FK_DEP_FUNC
        FOREIGN KEY FUNCIONARIOS(COD_DEP)
        REFERENCES DEPARTAMENTO(COD_DEP),
    CONSTRAINT FK_CARGO_FUNC
        FOREIGN KEY FUNCIONARIOS(COD_CARGO)
        REFERENCES CARGOS(COD_CARGO)
);
 
--  TABELA FILHA/ASSOCIATIVA: HOLERITH
CREATE TABLE HOLERITH
(
    COD_FIL INT NOT NULL,
    COD_FUN INT NOT NULL,
    COD_PROV INT NOT NULL,
    COMPETENCIA DATE NOT NULL,
    FATOR_H_D DECIMAL(10,2),
    VALOR DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (COD_FIL, COD_FUN, COD_PROV, COMPETENCIA),
    CONSTRAINT FK_FILIAL_HOLERITH
        FOREIGN KEY HOLERITH(COD_FIL)
        REFERENCES FILIAIS(COD_FIL),
    CONSTRAINT FK_FUNC_HOLERITH
        FOREIGN KEY HOLERITH(COD_FUN)
        REFERENCES FUNCIONARIOS(COD_FUN),
    CONSTRAINT FK_PROV_HOLERITH
        FOREIGN KEY HOLERITH(COD_PROV)
        REFERENCES PROV_DESC(COD_PROV)
);
 
-- CONFERENCIA
SHOW TABLES;
